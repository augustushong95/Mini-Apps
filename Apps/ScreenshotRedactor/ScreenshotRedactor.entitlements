<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Read the screenshot folder the user picks, save redacted copies where
	     they choose (Save As…), and move an original to the Trash on request. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Keep access to that screenshot folder across launches (security-scoped bookmark). -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Deliberately no com.apple.security.network.client or .server:
	     the app works fully offline and the sandbox blocks every connection. -->
</dict>
</plist>
